# Comma-separated origins allowed to call the operator API from a browser.
SIH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://10.20.72.81:3000,http://10.20.72.81:3002

# Only RTSP hosts resolving to these CIDRs can be tested by /api/cameras/test-stream.
SIH_ALLOWED_CAMERA_CIDRS=10.20.72.0/24

# Max VRAM (GB) each ONNX CUDA arena may allocate. 0 = unlimited.
SIH_GPU_MEM_LIMIT_GB=0

# Hardware acceleration: dedicated NVIDIA GPU (NVIDIA T400 4GB)
SIH_DEVICE=cuda
SIH_CUDA_DEVICE_ID=0

